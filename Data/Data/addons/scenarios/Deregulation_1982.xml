        <route departure="DAL" destination="OKC" coach="MCI MC-9 Crusader II" quantity="2" />
        <route departure="DAL" destination="SAT" coach="MCI MC-9 Crusader II" quantity="3" />
        <route departure="DAL" destination="MEM" coach="MCI MC-9 Crusader II" quantity="2" />
        <route departure="DAL" destination="ELP" coach="MCI MC-9 Crusader II" quantity="2" />
