<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheBusProject.Desktop.Views.CreateRouteForm">
  <StackPanel Spacing="8">
    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" />

    <ItemsControl ItemsSource="{Binding Offers}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="#3A2E1A" CornerRadius="4" Padding="8" Margin="0,0,0,6">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                        IsVisible="{Binding CanLease}" HorizontalAlignment="Stretch" />
              <Button Content="Lease gates" Command="{Binding LeaseCommand}" IsVisible="{Binding CanLease}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Spacing="8" IsVisible="{Binding ShowTier}">
      <TextBlock Text="Service" />
      <ComboBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding Tier}" HorizontalAlignment="Stretch" />
    </StackPanel>
    <StackPanel Spacing="8" IsVisible="{Binding ShowPrice}">
      <TextBlock Text="Price per unit of cargo" />
      <TextBox Text="{Binding CargoPrice}" />
    </StackPanel>
    <TextBlock Text="{Binding CoachLabel}" />
    <ComboBox ItemsSource="{Binding Coaches}" SelectedItem="{Binding SelectedCoach}" HorizontalAlignment="Stretch" />

    <StackPanel Spacing="6">
      <TextBlock Text="Stops along the way" />
      <TextBlock Text="{Binding StopsText}" TextWrapping="Wrap" Opacity="0.75" />
      <TextBlock Text="{Binding BreaksText}" TextWrapping="Wrap" Opacity="0.75" />
      <TextBlock Text="{Binding StopsProblem}" TextWrapping="Wrap" Foreground="#c0392b" IsVisible="{Binding HasStopsProblem}" />
      <Grid ColumnDefinitions="*,Auto,Auto">
        <ComboBox Grid.Column="0" ItemsSource="{Binding StopChoices}" SelectedItem="{Binding ChosenStop}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Profile.Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Content="Add stop" Command="{Binding AddStopCommand}" Margin="6,0,0,0" />
        <Button Grid.Column="2" Content="Fill in" Command="{Binding FillStopsCommand}" Margin="6,0,0,0"
                ToolTip.Tip="Puts in the stops the service needs so no leg is beyond the coach's range or beyond a driver's day" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <ComboBox Grid.Column="0" ItemsSource="{Binding Stops}" SelectedItem="{Binding ChosenCall}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Profile.Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Content="Take off" Command="{Binding RemoveStopCommand}" Margin="6,0,0,0" />
      </Grid>
    </StackPanel>

    <StackPanel Spacing="8" IsEnabled="{Binding ScheduleEnabled}">
      <TextBlock Text="Schedule" />
      <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}" HorizontalAlignment="Stretch" IsEnabled="{Binding DetailEnabled}" />
      <TextBlock Text="Turnaround (minutes)" />
      <ComboBox ItemsSource="{Binding Turnarounds}" SelectedItem="{Binding Turnaround}" HorizontalAlignment="Stretch" IsEnabled="{Binding DetailEnabled}" />
      <TextBlock Text="Round trips per day" />
      <ComboBox ItemsSource="{Binding Trips}" SelectedItem="{Binding RoundTrips}" HorizontalAlignment="Stretch" IsEnabled="{Binding DetailEnabled}" />
      <TextBlock Text="First departure" />
      <ComboBox ItemsSource="{Binding StartTimes}" SelectedItem="{Binding StartTime}" HorizontalAlignment="Stretch" IsEnabled="{Binding DetailEnabled}" />
      <CheckBox Content="Start running straight away" IsChecked="{Binding StartCoach}" />
    </StackPanel>

    <TextBlock Text="{Binding Forecast}" TextWrapping="Wrap" IsVisible="{Binding HasForecast}" Foreground="#9CC3E6" />
    <TextBlock Text="{Binding CantFly}" TextWrapping="Wrap" IsVisible="{Binding HasCantFly}" Foreground="#E6B89C" />
    <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Opacity="0.85" />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="Cancel" Command="{Binding CancelCommand}" />
      <Button Content="{Binding CreateLabel}" Command="{Binding CreateCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
